# Comet 29P/Schwassmann-Wachmann: processing archival photometric records

This notebook parses ten text files of archival observation records (2015 to April 2025) into a single table of dates and magnitudes, converts the dates to Julian Date, separates the filter code, and selects the R-band entries. It then plots the R-band light curve and its brightness gradient, and fits a sinusoid.

Place the input files in a folder called `data/` next to this notebook (`29P_2015.txt`, `29P_2016.txt`, `29P_2017.txt`, `29P_2018-19.txt`, ... `29P_2024-25.txt`).

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import re
import os
from astropy.time import Time
from scipy.optimize import curve_fit

# Define the directory containing the files
data_directory = "data"

# Define the input files
input_files = [
    "29P_2015.txt",
    "29P_2016.txt",
    "29P_2017.txt",
    "29P_2018-19.txt",
    "29P_2019-20.txt",
    "29P_2020-21.txt",
    "29P_2021-22.txt",
    "29P_2022-23.txt",
    "29P_2023-24.txt",
    "29P_2024-25.txt"
]

# Define the output file path
output_file = os.path.join(data_directory, "29P_Date_Magnitude.txt")

# Initialize a list to store all processed data and a log dictionary
all_data = []
file_log = {}

# Regular expressions to extract date and magnitude/filter information
pattern_date = re.compile(r"(\d{4})\s(\d{2})\s(\d{1,2}\.\d+)")
pattern_mag = re.compile(r"(\d{2}\.\d{1,2}[A-Za-z])")

# Process each file
for file_name in input_files:
    file_path = os.path.join(data_directory, file_name)

    if not os.path.exists(file_path):
        print(f"Warning: File not found - {file_path}")
        continue

    with open(file_path, "r") as file:
        lines = file.readlines()

    original_line_count = len(lines)
    processed_line_count = 0

    for line in lines:
        # Search for date and magnitude in each line
        date_match = pattern_date.search(line)
        mag_match = pattern_mag.search(line)

        if date_match and mag_match:
            year, month, day = date_match.groups()
            day_decimal = round(float(day), 5)
            date = f"{year} {month} {day_decimal:08.5f}"
            magnitude = mag_match.group(1)

            all_data.append([date, magnitude])
            processed_line_count += 1

    # Store log information
    file_log[file_name] = {
        "Original lines": original_line_count,
        "Processed lines": processed_line_count
    }

# Save results to output file
with open(output_file, "w") as out_file:
    out_file.write("Date\tMagnitude\n")
    for entry in all_data:
        out_file.write("\t".join(entry) + "\n")

# Print summary of each file's processing
print(f"Processing complete. Results saved to: {output_file}")
for file, stats in file_log.items():
    print(f"{file}: {stats['Original lines']} lines read, {stats['Processed lines']} lines processed.")

# Convert to Julian Dates 

data_directory = "data"
input_file = os.path.join(data_directory, "29P_Date_Magnitude.txt")
input_file_2015 = os.path.join(data_directory, "29P_2015.txt")
output_file = os.path.join(data_directory, "29P_Julian_Magnitude_Filter.txt")

# Load the main data into a DataFrame
df = pd.read_csv(input_file, sep="\t")
# (Expected columns: "Date" and "Magnitude")

# Function to convert a Date string to Julian Date.
def to_julian(date_str):
    """
    Expects date_str in the format: "YYYY MM DD.DDDDD"
    For example: "2024 05 12.34567"
    """
    parts = date_str.split()
    if len(parts) < 3:
        print("Error: Invalid date format:", date_str)
        return None
    year, month, day_decimal = parts
    # Convert day_decimal into an integer day and a fractional part
    day_decimal_float = float(day_decimal)
    day_int = int(day_decimal_float)
    day_fraction = day_decimal_float - day_int
    # Convert the fractional day to hours and minutes (ignore seconds)
    total_minutes = int(day_fraction * 1440)  # 1440 minutes in a day
    hours = total_minutes // 60
    minutes = total_minutes % 60
    # Compose an ISO-formatted date-time string (e.g., "2024-05-12 08:30")
    date_iso = f"{year}-{month}-{day_int:02d} {hours:02d}:{minutes:02d}"
    t = Time(date_iso, format='iso', scale='utc')
    return round(t.jd, 5)

# Apply the conversion to produce a new "Julian Date" column.
df["Julian Date"] = df["Date"].apply(to_julian)

# Separate Magnitude and Filter.
# The convention is that the Filter is the last character in the Magnitude field.
df["Filter"] = df["Magnitude"].str[-1]         # Extract the last character as Filter.
df["Magnitude"] = df["Magnitude"].str[:-1]       # The rest is the numeric magnitude.

# Extract Year from the Date (assumes the first token in 'Date' is the year)
df["Year"] = df["Date"].str.split().str[0]

# Keep only the desired columns and set proper order.
df_final = df[["Year", "Julian Date", "Magnitude", "Filter"]]

# Now process the 2015 data separately.
# (Assuming the 2015 file has no header and that the Julian Date is in column 4 and Magnitude is in column 5)
df_2015 = pd.read_csv(input_file_2015, sep="\t", header=None, usecols=[4, 5], 
                      names=["Julian Date", "Magnitude"])
# For 2015 data, assign a Year and an empty Filter column.
df_2015["Year"] = "2015"
df_2015["Filter"] = ""

# Combine the main (2024–2025) data with the 2015 data.
df_combined = pd.concat([df_final, df_2015[["Year", "Julian Date", "Magnitude", "Filter"]]], 
                        ignore_index=True)

# Sort the combined data by 'Year' and 'Julian Date'
df_combined = df_combined.sort_values(by=["Year", "Julian Date"])

# Save the processed data to the output file.
df_combined.to_csv(output_file, sep='\t', index=False)

# Report summary
input_count = len(df) + len(df_2015)
output_count = len(df_combined)
print(f"Processing complete. Output file saved to: {output_file}")
print(f"Input entries (main + 2015): {input_count}")
print(f"Output entries: {output_count}")

# Print the unique filter values found in the data.
unique_filters = df_combined["Filter"].unique()
print("Unique filter values found:", unique_filters)

# Select R-Band observations

